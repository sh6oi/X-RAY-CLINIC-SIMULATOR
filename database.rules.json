{
  "rules": {
    ".read": false,
    ".write": false,
    "clinics": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email', 'createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "save": {
          ".validate": "newData.hasChildren(['cash', 'totalRevenue', 'films', 'cartonsBought', 'patientsServed', 'retakesCount', 'filmDebt', 'soundEnabled'])",
          "cash": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "totalRevenue": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "films": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "cartonsBought": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "patientsServed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "retakesCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "filmDebt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "soundEnabled": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "currentDay": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
          },
          "dailyTargetPatients": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
          },
          "dailyPatientsHandled": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "dailyEarned": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "dailySpentPurchases": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "dailySpentExpenses": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "dailyRetakes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "dailyFilmsUsed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "dayCompletedAwaitingNext": {
            ".validate": "newData.isBoolean()"
          },
          "dayHistory": {
            "$idx": {
              ".validate": "newData.hasChildren(['dayNumber', 'patientsTarget', 'patientsCompleted', 'earned', 'spentPurchases', 'spentExpenses', 'doctorDeduction', 'netProfit', 'endedAt'])",
              "dayNumber": {
                ".validate": "newData.isNumber() && newData.val() >= 1"
              },
              "patientsTarget": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "patientsCompleted": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "earned": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "spentPurchases": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "spentExpenses": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "doctorDeduction": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "netProfit": {
                ".validate": "newData.isNumber()"
              },
              "retakes": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "filmsUsed": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "endedAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "ownedUpgrades": {
            "$idx": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          },
          "completedCases": {
            "$idx": {
              ".validate": "newData.hasChildren(['id', 'patientNameAr', 'examTitleAr', 'modality', 'earned', 'timestamp'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "patientNameAr": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "patientAvatarPath": {
                ".validate": "newData.isString() && newData.val().length <= 50000"
              },
              "examTitleAr": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "examImagePath": {
                ".validate": "newData.isString() && newData.val().length <= 50000"
              },
              "modality": {
                ".validate": "newData.val() === 'XRAY' || newData.val() === 'CT' || newData.val() === 'MRI'"
              },
              "findingAr": {
                ".validate": "newData.isString() && newData.val().length <= 600"
              },
              "earned": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "kvpUsed": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
              },
              "masUsed": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "shieldUsed": {
                ".validate": "newData.isBoolean()"
              },
              "postureUsed": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "timestamp": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
